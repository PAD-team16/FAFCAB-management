		{
			"name": "Email Notifications",
			"item": [
				{
					"name": "Send Email",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains success message\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"Email sent successfully\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"to\": \"{{test_email}}\",\n    \"message\": \"{{test_message}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/email/send",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"email",
								"send"
							]
						},
						"description": "Send an email notification to a specified recipient"
					},
					"response": [
						{
							"name": "Success Response",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json",
										"type": "text"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"to\": \"test@example.com\",\n    \"message\": \"Hello from Notification Service!\"\n}"
								},
								"url": {
									"raw": "{{base_url}}/api/email/send",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"email",
										"send"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "plain",
							"header": [
								{
									"key": "Content-Type",
									"value": "text/plain;charset=UTF-8"
								}
							],
							"cookie": [],
							"body": "Email sent successfully"
						}
					]
				}
			],
			"description": "Endpoints for sending email notifications via SMTP"
