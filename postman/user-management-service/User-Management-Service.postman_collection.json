{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-123456789012",
		"name": "FAFCAB User Management Service",
		"description": "API collection for testing the User Management Service endpoints of the FAFCAB Cabinet Management Platform",
