	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const responseJson = pm.response.json();",
									"    pm.environment.set('jwt_token', responseJson.jwt);",
									"    pm.environment.set('user_id', responseJson.user_id);",
									"    pm.test('JWT token received', function () {",
									"        pm.expect(responseJson.jwt).to.be.a('string');",
									"    });",
									"    pm.test('User ID received', function () {",
									"        pm.expect(responseJson.user_id).to.be.a('string');",
									"    });",
									"} else {",
									"    pm.test('Login failed with expected error', function () {",
									"        pm.expect(pm.response.code).to.be.oneOf([404, 400]);",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{test_username}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}{{api_base_path}}/auth/login",
							"host": [
								"{{base_url}}{{api_base_path}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticate a user with username and receive JWT token and user ID"
					},
					"response": []
				},
				{
					"name": "Login using Discord Oauth2",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}{{api_base_path}}/auth/login/discord",
							"host": [
								"{{base_url}}{{api_base_path}}"
							],
							"path": [
								"auth",
								"login",
								"discord"
							]
						},
						"description": "Login using Discord OAuth2 token to create or retrieve user and receive JWT token"
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for user login and token generation"
		},
